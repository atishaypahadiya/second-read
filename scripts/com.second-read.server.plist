<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Template. scripts/install.sh fills in __PYTHON__, __REPO__, __HOME__ and the extension ID and copies it to
       ~/Library/LaunchAgents/com.second-read.server.plist -->
  <key>Label</key>
  <string>com.second-read.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-u</string>
    <string>__REPO__/server/server.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart whenever the process exits (crash or otherwise); wait 5s between restarts. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/second-read.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/second-read.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <!-- __EXTENSION_ID_ENV__ : install.sh puts SR_EXTENSION_ID here (or removes this line) -->
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
